# Production env for VPS Docker Compose
# Copy to .env next to docker-compose.prod.yml on the server:
#   cp .env.prod.example .env

# Domain that points to this VPS (A record). Used by Caddy for HTTPS.
# Example: api.yourdomain.com
API_DOMAIN=api.example.com

# Strong secrets (change these)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
POSTGRES_PASSWORD=change-me-postgres-password
RABBITMQ_PASSWORD=change-me-rabbit-password

# Set AFTER Vercel deploy (your *.vercel.app URL, no trailing slash)
TALENTPULSE_FRONTEND_URL=https://your-app.vercel.app
